aws_region          = "us-east-2"
deployment_role_arn = null
chart_version       = "1.9.2"
controller_replicas = 2

controller_resources = {
  requests = { cpu = "200m", memory = "256Mi" }
  limits   = { cpu = "1", memory = "1Gi" }
}

instance_types      = ["t3.medium", "t3.large", "m5.large", "m6i.large"]
cpu_limit           = "20"
memory_limit        = "80Gi"
consolidation_after = "1m"
expire_after        = "168h"
root_volume_size    = "30Gi"

tags = {
  Owner      = "platform-engineering"
  CostCenter = "00000001"
}
